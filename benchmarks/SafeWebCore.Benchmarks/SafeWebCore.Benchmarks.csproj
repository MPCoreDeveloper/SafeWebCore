<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Benchmarks stay on net10.0 on purpose. BenchmarkDotNet 0.15.8 (latest stable) has no
         `Net11_0` runtime moniker: running this project on net11.0 fails with
         `NotImplementedException: GetRuntimeVersion not implemented for NotRecognized`. Add net11.0
         to this list once a stable BenchmarkDotNet recognises it, then run with `-f net11.0`. -->
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <!-- BenchmarkDotNet requires instance (non-static) benchmark methods; suppress CA1822 project-wide -->
    <NoWarn>$(NoWarn);CA1822</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\SafeWebCore\SafeWebCore.csproj" />
  </ItemGroup>

</Project>
