<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <PackageId>SafeWebCore</PackageId>
    <Version>1.7.0</Version>
    <Authors>MPCoreDeveloper</Authors>
    <Company>Posseth Software</Company>
    <Product>SafeWebCore</Product>
    <Description>Lightweight, high-performance ASP.NET Core middleware that adds security headers targeting an A+ rating on securityheaders.com. Includes nonce-based CSP, Strict-Transport-Security, Permissions-Policy, Cross-Origin isolation, Trusted Types, and more â€” all configurable with a single line of code.</Description>
    <PackageTags>security;headers;csp;content-security-policy;hsts;xss;middleware;aspnetcore;nonce;strict-dynamic;trusted-types;permissions-policy;securityheaders</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SafeWebCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SafeWebCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>
## v1.7.0 — Path policy inheritance, OWASP API + NSwag presets

**Security (issue #3):**
- New `PathPolicy(...)` extension method: path policies now inherit the global configuration and only override explicitly set values — prevents accidental security header downgrades (e.g. weaker HSTS on /api)
- `ApplyPreset(...)` and `Clone()` are now public — official inheritance mechanism for path policies and custom presets
- `NetSecureHeadersOptions.PathPolicy("...")` with global inheritance is the recommended path policy API

**New presets:**
- `SecurePresets.OwaspApi()` / `AddNetSecureHeadersOwaspApiPreset(...)` — OWASP API Security Top 10 aligned response-header hardening for API endpoints
- `SecurePresets.NSwag()` / `AddNetSecureHeadersNSwagPreset(...)` — NSwag UI (Rico Sutter) preset with nonce-based CSP and unpkg CDN assets
- `SecurePresets.OwaspApiPath()` — path policy helper for OWASP API preset

**Compatibility:** 100% backward compatible. All new APIs are additive and opt-in.

See CHANGELOG.md and docs/ for full details.
    </PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 MPCoreDeveloper</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- SourceLink for deterministic builds -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Public API surface tracking for backward compatibility (additive, build-time only) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Explicitly register the public API baseline files -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Public API baseline enforcement (roadmap v1.4 item 1.2) -->
  <PropertyGroup>
    <!-- Generate / validate PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt -->
    <GeneratePublicApiFiles>true</GeneratePublicApiFiles>
    <!-- RS0037 = removal or rename of a previously shipped public API symbol â†’ hard error (protects backward compatibility) -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0037</WarningsAsErrors>
    <!-- During initial rollout of public API tracking (v1.4 item 1.2):
         - RS0016 (public symbol not declared in the txt files) â†’ warning
         - RS0017 (symbol listed in txt files but not found / not public) â†’ warning
         This lets us introduce the mechanism without a perfect baseline on day one.
         After the baseline is curated and stable, remove these from WarningsNotAsErrors
         to enforce a clean public surface. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Files included in the NuGet package -->
  <ItemGroup>
    <None Include="..\..\PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

</Project>
