    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Explicitly register the public API baseline files -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Public API baseline enforcement (roadmap v1.4 item 1.2) -->
  <PropertyGroup>
    <!-- Generate / validate PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt -->
    <GeneratePublicApiFiles>true</GeneratePublicApiFiles>
    <!-- RS0037 = removal or rename of a previously shipped public API symbol â†’ hard error (protects backward compatibility) -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0037</WarningsAsErrors>
    <!-- During initial rollout of public API tracking (v1.4 item 1.2):
         - RS0016 (public symbol not declared in the txt files) â†’ warning
         - RS0017 (symbol listed in txt files but not found / not public) â†’ warning
         This lets us introduce the mechanism without a perfect baseline on day one.
         After the baseline is curated and stable, remove these from WarningsNotAsErrors
         to enforce a clean public surface. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Files included in the NuGet package -->
  <ItemGroup>
    <None Include="..\..\PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

</Project>
