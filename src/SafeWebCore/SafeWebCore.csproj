<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Multi-targeting: net10.0 keeps the shipped baseline, net11.0 ships the same public API
         built against the .NET 11 runtime, so a net11.0 consumer gets the net11.0 asset (C# 15
         language version and the .NET 11 JIT) instead of falling back to the net10.0 one. -->
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <PackageId>SafeWebCore</PackageId>
    <Version>1.9.0</Version>
    <Authors>MPCoreDeveloper</Authors>
    <Company>Posseth Software</Company>
    <Product>SafeWebCore</Product>
    <Description>Lightweight, high-performance ASP.NET Core middleware that adds security headers targeting an A+ rating on securityheaders.com. Includes nonce-based CSP, Strict-Transport-Security, Permissions-Policy, Cross-Origin isolation, Trusted Types, and more â€” all configurable with a single line of code.</Description>
    <PackageTags>security;headers;csp;content-security-policy;hsts;xss;middleware;aspnetcore;nonce;strict-dynamic;trusted-types;permissions-policy;securityheaders</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SafeWebCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SafeWebCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>PACKAGE.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
        <PackageReleaseNotes>
## v1.9.0 — Multi-targeting .NET 10 and .NET 11

**100% backwards compatible** — the public API surface, defaults, presets and configuration paths are unchanged. The package now ships a `net11.0` asset next to the existing `net10.0` one, so a .NET 11 application resolves the build made for its runtime instead of falling back to `net10.0`.

**What's new:**
- `lib/net11.0` — the same public API, compiled against .NET 11 (C# 15 and the .NET 11 JIT). `lib/net10.0` is unchanged and stays the target for .NET 10 applications.
- C# 15 collection-expression arguments (`[with(capacity: ...)]`, `[with(comparer: ...)]`) where the capacity or comparer is known, so the diagnostics preview no longer grows its header map and the options validator passes its comparer inside the collection expression. No behavior change.
- Repository: publishing is keyless through nuget.org trusted publishing, and mutation testing with Stryker.NET records the test-suite baseline in `docs/development/mutation-testing.md`.

See CHANGELOG.md and docs/ for full details.
    </PackageReleaseNotes>
    <Copyright>Copyright (c) 2026 MPCoreDeveloper</Copyright>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>

  <!-- SourceLink for deterministic builds -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Public API surface tracking for backward compatibility (additive, build-time only) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Explicitly register the public API baseline files -->
  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

  <!-- Public API baseline enforcement (roadmap v1.4 item 1.2) -->
  <PropertyGroup>
    <!-- Generate / validate PublicAPI.Shipped.txt and PublicAPI.Unshipped.txt -->
    <GeneratePublicApiFiles>true</GeneratePublicApiFiles>
    <!-- RS0037 = removal or rename of a previously shipped public API symbol â†’ hard error (protects backward compatibility) -->
    <WarningsAsErrors>$(WarningsAsErrors);RS0037</WarningsAsErrors>
    <!-- During initial rollout of public API tracking (v1.4 item 1.2):
         - RS0016 (public symbol not declared in the txt files) â†’ warning
         - RS0017 (symbol listed in txt files but not found / not public) â†’ warning
         This lets us introduce the mechanism without a perfect baseline on day one.
         After the baseline is curated and stable, remove these from WarningsNotAsErrors
         to enforce a clean public surface. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- Files included in the NuGet package -->
  <ItemGroup>
    <None Include="..\..\PACKAGE.md" Pack="true" PackagePath="\" />
    <None Include="..\..\icon.png" Pack="true" PackagePath="\" Condition="Exists('..\..\icon.png')" />
  </ItemGroup>

</Project>
