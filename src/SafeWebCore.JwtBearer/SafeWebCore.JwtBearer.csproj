<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>SafeWebCore.JwtBearer</RootNamespace>
  </PropertyGroup>

  <!-- NuGet Package Metadata -->
  <PropertyGroup>
    <PackageId>SafeWebCore.JwtBearer</PackageId>
    <Version>1.0.1</Version>
    <Authors>MPCoreDeveloper</Authors>
    <Company>Posseth Software</Company>
    <Product>SafeWebCore.JwtBearer</Product>
    <Description>
      Optional companion module for SafeWebCore that validates the JWT authentication
      authority at startup. Detects a misconfigured or unreachable OpenID Connect authority
      (for example a typo such as "organisations") with a loud log or a fail-fast startup,
      instead of a silent 100% 401 availability incident.
    </Description>
    <PackageTags>jwt;bearer;oidc;authority;startup-validation;security;aspnetcore;safeweb</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MPCoreDeveloper/SafeWebCore</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MPCoreDeveloper/SafeWebCore</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>
## v1.0.1 — Dependency maintenance

Maintenance patch. **100% backwards compatible** — no public API or behavior change.

- `Microsoft.AspNetCore.Authentication.JwtBearer` dependency updated from 10.0.11 to 10.0.12, so the package now requires that patch or newer
- Packaging parity with core and `SafeWebCore.FraudDetection`: the package now ships a `.snupkg` symbol package with SourceLink and deterministic builds, and embeds these release notes in the nuspec. This is the first JwtBearer version to carry the badge-corrected packaged `README.md`

See CHANGELOG.md and docs/ for full details.
    </PackageReleaseNotes>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- SourceLink for deterministic builds (parity with core and FraudDetection) -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
  </ItemGroup>

  <!-- Public API surface tracking for backward compatibility (additive, build-time only) -->
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
    <InternalsVisibleTo Include="SafeWebCore.JwtBearer.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <GeneratePublicApiFiles>true</GeneratePublicApiFiles>
    <WarningsAsErrors>$(WarningsAsErrors);RS0037</WarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);RS0016;RS0017</WarningsNotAsErrors>
    <NoWarn>$(NoWarn);RS0027</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\icon.png" Link="icon.png">
      <PackagePath>\</PackagePath>
      <Pack>true</Pack>
    </None>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
